import java.util.*;

class Solution {
    public int minimumPushes(String word) {
        int[] freq = new int[26];

        // Count frequency
        for (char c : word.toCharArray()) {
            freq[c - 'a']++;
        }

        // Sort in descending order
        Arrays.sort(freq);

        int pushes = 0;
        int index = 0;

        // Traverse from highest frequency
        for (int i = 25; i >= 0; i--) {
            if (freq[i] == 0) break;
            pushes += freq[i] * (index / 8 + 1);
            index++;
        }

        return pushes;
    }
}
