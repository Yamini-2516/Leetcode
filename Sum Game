class Solution {
    public boolean sumGame(String num) {
        int n = num.length();

        int sumLeft = 0;
        int sumRight = 0;

        int questionLeft = 0;
        int questionRight = 0;

        // First half
        for (int i = 0; i < n / 2; i++) {
            char ch = num.charAt(i);

            if (ch == '?') {
                questionLeft++;
            } else {
                sumLeft += ch - '0';
            }
        }

        // Second half
        for (int i = n / 2; i < n; i++) {
            char ch = num.charAt(i);

            if (ch == '?') {
                questionRight++;
            } else {
                sumRight += ch - '0';
            }
        }

        // Odd number of '?' -> Alice can always win
        if ((questionLeft + questionRight) % 2 == 1) {
            return true;
        }

        // Bob can win only if the difference can be exactly balanced
        return sumLeft - sumRight
                != 9 * (questionRight - questionLeft) / 2;
    }
}
