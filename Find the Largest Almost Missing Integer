class Solution {
    public int largestInteger(int[] nums, int k) {
        int n = nums.length;

        if (k == 1) {
            Map<Integer, Integer> freq = new HashMap<>();
            for (int x : nums) {
                freq.put(x, freq.getOrDefault(x, 0) + 1);
            }

            int ans = -1;
            for (int x : nums) {
                if (freq.get(x) == 1) {
                    ans = Math.max(ans, x);
                }
            }
            return ans;
        }

        if (k == n) {
            int ans = nums[0];
            for (int x : nums) {
                ans = Math.max(ans, x);
            }
            return ans;
        }

        int ans = -1;

        boolean uniqueFirst = true;
        for (int i = 1; i < n; i++) {
            if (nums[i] == nums[0]) {
                uniqueFirst = false;
                break;
            }
        }
        if (uniqueFirst) ans = nums[0];

        boolean uniqueLast = true;
        for (int i = 0; i < n - 1; i++) {
            if (nums[i] == nums[n - 1]) {
                uniqueLast = false;
                break;
            }
        }
        if (uniqueLast) ans = Math.max(ans, nums[n - 1]);

        return ans;
    }
}
