class Solution {

    public String lexPalindromicPermutation(String s, String target) {

        int n = s.length();
        int half = n / 2;

        int[] cnt = new int[26];

        // Count characters
        for (char ch : s.toCharArray()) {
            cnt[ch - 'a']++;
        }

        // Check whether palindrome is possible
        int odd = 0;
        char middle = 0;

        for (int i = 0; i < 26; i++) {
            if (cnt[i] % 2 == 1) {
                odd++;
                middle = (char) ('a' + i);
            }
        }

        if (odd > 1) {
            return "";
        }

        // Number of characters required in left half
        int[] left = new int[26];

        for (int i = 0; i < 26; i++) {
            left[i] = cnt[i] / 2;
        }

        /*
         * Try making the left half exactly equal
         * to target's left half.
         */
        int[] rem = left.clone();
        boolean possible = true;

        for (int i = 0; i < half; i++) {

            int c = target.charAt(i) - 'a';

            if (rem[c] == 0) {
                possible = false;
                break;
            }

            rem[c]--;
        }

        /*
         * If the left half can be equal to target's
         * left half, check the right half.
         */
        if (possible) {

            String leftPart = target.substring(0, half);

            StringBuilder candidate = new StringBuilder();

            candidate.append(leftPart);

            if (n % 2 == 1) {
                candidate.append(middle);
            }

            candidate.append(
                new StringBuilder(leftPart).reverse()
            );

            if (candidate.toString().compareTo(target) > 0) {
                return candidate.toString();
            }
        }

        /*
         * Now we need to make the left half
         * strictly greater than target's left half.
         *
         * Start from the rightmost position and
         * try to increase it.
         */
        int[] remaining = left.clone();

        // Consume target's left half as far as possible
        for (int i = 0; i < half; i++) {

            int c = target.charAt(i) - 'a';

            if (remaining[c] == 0) {
                break;
            }

            remaining[c]--;
        }

        /*
         * Backtrack from right to left.
         */
        for (int i = half - 1; i >= 0; i--) {

            /*
             * Rebuild remaining counts for prefix
             * target[0 ... i-1].
             */
            remaining = left.clone();

            boolean prefixPossible = true;

            for (int k = 0; k < i; k++) {

                int c = target.charAt(k) - 'a';

                if (remaining[c] == 0) {
                    prefixPossible = false;
                    break;
                }

                remaining[c]--;
            }

            if (!prefixPossible) {
                continue;
            }

            int current = target.charAt(i) - 'a';

            /*
             * Try the smallest character greater
             * than target[i].
             */
            for (int next = current + 1; next < 26; next++) {

                if (remaining[next] == 0) {
                    continue;
                }

                remaining[next]--;

                StringBuilder leftPart = new StringBuilder();

                // Same prefix
                for (int k = 0; k < i; k++) {
                    leftPart.append(target.charAt(k));
                }

                // Bigger character at position i
                leftPart.append((char) ('a' + next));

                // Fill remaining positions with smallest chars
                for (int c = 0; c < 26; c++) {

                    while (remaining[c] > 0) {
                        leftPart.append((char) ('a' + c));
                        remaining[c]--;
                    }
                }

                // Construct palindrome
                StringBuilder answer = new StringBuilder();

                answer.append(leftPart);

                if (n % 2 == 1) {
                    answer.append(middle);
                }

                answer.append(
                    new StringBuilder(leftPart).reverse()
                );

                return answer.toString();
            }
        }

        return "";
    }
}
